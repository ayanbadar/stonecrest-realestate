# Django
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings
ENVIRONMENT=local

# Database (hostname `db` inside Compose)
POSTGRES_DB=stonecrest
POSTGRES_USER=stonecrest
POSTGRES_PASSWORD=stonecrest
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://stonecrest:stonecrest@db:5432/stonecrest

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS (comma-separated origins). When DEBUG=True and this is empty, all origins are allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False

# Auth / email (console backend prints reset links in backend logs during local dev)
FRONTEND_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=noreply@stonecrestdxb.com
INQUIRY_NOTIFICATION_EMAIL=hello@stonecrestdxb.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Documents / media storage
# ENVIRONMENT=local → local MEDIA_ROOT. Set USE_S3=True (or ENVIRONMENT≠local) for S3.
# USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=stonecrest-media
# AWS_S3_REGION_NAME=me-central-1
# AWS_S3_CUSTOM_DOMAIN=
# AWS_QUERYSTRING_AUTH=True
